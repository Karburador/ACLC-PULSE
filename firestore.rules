rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLabCode(code) {
      return code is string && code.size() >= 1 && code.size() <= 32 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Campus Administrator (zero-read token claim check)
    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'barracudaskynet@gmail.com';
    }

    function isOwnerOrAdmin() {
      return isBootstrappedAdmin() || existing().ownerId == request.auth.uid;
    }

    function isDocOwnerOrAdmin() {
      return isBootstrappedAdmin() || resource.data.ownerId == request.auth.uid;
    }

    // Entity Validation Blueprints
    function isValidLaboratory(data) {
      return data.keys().hasAll(['code', 'name', 'roomNumber', 'capacity', 'isCustom', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'name', 'roomNumber', 'capacity', 'description', 'isCustom', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidLabCode(data.code)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 60
        && data.capacity is number && data.capacity >= 1 && data.capacity <= 10000
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.isCustom is bool
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStorageLocation(loc) {
      return loc is map
        && loc.keys().hasAll(['rackOrCabinet', 'shelf'])
        && loc.keys().hasOnly(['rackOrCabinet', 'shelf', 'slot'])
        && loc.rackOrCabinet is string && loc.rackOrCabinet.size() >= 1 && loc.rackOrCabinet.size() <= 120
        && loc.shelf is string && loc.shelf.size() >= 1 && loc.shelf.size() <= 120
        && (!('slot' in loc) || (loc.slot is string && loc.slot.size() <= 120));
    }

    function isValidMonitorInfo(mon) {
      return mon is map
        && mon.keys().hasOnly(['brandModel', 'serialNumber', 'specs'])
        && (!('brandModel' in mon) || (mon.brandModel is string && mon.brandModel.size() <= 120))
        && (!('serialNumber' in mon) || (mon.serialNumber is string && mon.serialNumber.size() <= 100))
        && (!('specs' in mon) || (mon.specs is string && mon.specs.size() <= 200));
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['id', 'assetTag', 'name', 'category', 'lab', 'status', 'quantity', 'availableQuantity', 'unit', 'storageLocation', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'assetTag', 'name', 'category', 'lab', 'status', 'quantity', 'availableQuantity', 'unit', 'serialNumber', 'brandModel', 'specs', 'storageLocation', 'monitorInfo', 'acquisitionDate', 'lastMaintained', 'notes', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.assetTag is string && data.assetTag.size() >= 1 && data.assetTag.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.category in ['Computers', 'Routers', 'Tools', 'Projectors', 'Peripherals', 'Consumables']
        && isValidLabCode(data.lab)
        && data.status in ['Available', 'In Use', 'Under Maintenance', 'Damaged', 'Archived']
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 100000
        && data.availableQuantity is number && data.availableQuantity >= 0 && data.availableQuantity <= data.quantity
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 40
        && (!('serialNumber' in data) || (data.serialNumber is string && data.serialNumber.size() <= 100))
        && (!('brandModel' in data) || (data.brandModel is string && data.brandModel.size() <= 120))
        && (!('specs' in data) || (data.specs is string && data.specs.size() <= 600))
        && isValidStorageLocation(data.storageLocation)
        && (!('monitorInfo' in data) || isValidMonitorInfo(data.monitorInfo))
        && (!('acquisitionDate' in data) || (data.acquisitionDate is string && data.acquisitionDate.size() <= 40))
        && (!('lastMaintained' in data) || (data.lastMaintained is string && data.lastMaintained.size() <= 40))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 600))
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['id', 'borrowerName', 'borrowerIdNumber', 'borrowerRole', 'departmentSection', 'assetId', 'assetTag', 'assetName', 'lab', 'quantity', 'dateBorrowed', 'expectedReturnDate', 'status', 'purpose', 'issuedBy', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'borrowerName', 'borrowerIdNumber', 'borrowerRole', 'departmentSection', 'assetId', 'assetTag', 'assetName', 'lab', 'quantity', 'dateBorrowed', 'expectedReturnDate', 'dateReturned', 'status', 'purpose', 'issuedBy', 'returnedNotes', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.borrowerName is string && data.borrowerName.size() >= 1 && data.borrowerName.size() <= 120
        && data.borrowerIdNumber is string && data.borrowerIdNumber.size() >= 1 && data.borrowerIdNumber.size() <= 64
        && data.borrowerRole in ['Student', 'Faculty', 'Staff', 'TESDA Scholar']
        && data.departmentSection is string && data.departmentSection.size() >= 1 && data.departmentSection.size() <= 80
        && isValidId(data.assetId)
        && data.assetTag is string && data.assetTag.size() >= 1 && data.assetTag.size() <= 64
        && data.assetName is string && data.assetName.size() >= 1 && data.assetName.size() <= 160
        && isValidLabCode(data.lab)
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 10000
        && data.dateBorrowed is string && data.dateBorrowed.size() >= 1 && data.dateBorrowed.size() <= 40
        && data.expectedReturnDate is string && data.expectedReturnDate.size() >= 1 && data.expectedReturnDate.size() <= 40
        && (!('dateReturned' in data) || (data.dateReturned is string && data.dateReturned.size() <= 40))
        && data.status in ['Active', 'Returned', 'Overdue']
        && data.purpose is string && data.purpose.size() >= 1 && data.purpose.size() <= 400
        && data.issuedBy is string && data.issuedBy.size() >= 1 && data.issuedBy.size() <= 120
        && (!('returnedNotes' in data) || (data.returnedNotes is string && data.returnedNotes.size() <= 400))
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaintenance(data) {
      return data.keys().hasAll(['id', 'title', 'lab', 'type', 'column', 'priority', 'scheduledDate', 'assignedTechnician', 'description', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'assetId', 'assetTag', 'lab', 'type', 'column', 'priority', 'scheduledDate', 'assignedTechnician', 'description', 'diagnosis', 'costEstimate', 'completedDate', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('assetId' in data) || (data.assetId is string && data.assetId.size() <= 128))
        && (!('assetTag' in data) || (data.assetTag is string && data.assetTag.size() <= 64))
        && isValidLabCode(data.lab)
        && data.type in ['Routine Preventive', 'PC Re-imaging', 'Network Audit', 'Hardware Repair', 'Safety Inspection']
        && data.column in ['Reported', 'Diagnosed', 'Under Repair', 'Replaced/Retired']
        && data.priority in ['Low', 'Medium', 'High', 'Critical']
        && data.scheduledDate is string && data.scheduledDate.size() >= 1 && data.scheduledDate.size() <= 40
        && data.assignedTechnician is string && data.assignedTechnician.size() >= 1 && data.assignedTechnician.size() <= 120
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 800
        && (!('diagnosis' in data) || (data.diagnosis is string && data.diagnosis.size() <= 600))
        && (!('costEstimate' in data) || (data.costEstimate is number && data.costEstimate >= 0 && data.costEstimate <= 10000000))
        && (!('completedDate' in data) || (data.completedDate is string && data.completedDate.size() <= 40))
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSystemMeta(data) {
      return data.keys().hasAll(['initialized', 'mode', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['initialized', 'mode', 'ownerId', 'createdAt', 'updatedAt'])
        && data.initialized is bool
        && data.mode in ['default', 'zero']
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Connection check document (for testConnection startup verification)
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
    }

    // Laboratories Collection
    match /laboratories/{labCode} {
      allow get: if isValidLabCode(labCode) && isVerified() && isOwnerOrAdmin();
      allow list: if isVerified() && isDocOwnerOrAdmin();

      allow create: if isValidLabCode(labCode)
        && isVerified()
        && isValidLaboratory(incoming())
        && incoming().code == labCode
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidLabCode(labCode)
        && isVerified()
        && isValidLaboratory(incoming())
        && isOwnerOrAdmin()
        && incoming().code == existing().code
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'roomNumber', 'capacity', 'description', 'updatedAt']);

      allow delete: if isValidLabCode(labCode)
        && isVerified()
        && isOwnerOrAdmin();
    }

    // Assets Collection
    match /assets/{assetId} {
      allow get: if isValidId(assetId) && isVerified() && isOwnerOrAdmin();
      allow list: if isVerified() && isDocOwnerOrAdmin();

      allow create: if isValidId(assetId)
        && isVerified()
        && isValidAsset(incoming())
        && incoming().id == assetId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(assetId)
        && isVerified()
        && isValidAsset(incoming())
        && isOwnerOrAdmin()
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['assetTag', 'name', 'category', 'lab', 'status', 'quantity', 'availableQuantity', 'unit', 'serialNumber', 'brandModel', 'specs', 'storageLocation', 'monitorInfo', 'acquisitionDate', 'lastMaintained', 'notes', 'updatedAt'])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly(['availableQuantity', 'status', 'updatedAt'])
        );

      allow delete: if isValidId(assetId)
        && isVerified()
        && isOwnerOrAdmin();
    }

    // Loans Collection
    match /loans/{loanId} {
      allow get: if isValidId(loanId) && isVerified() && isOwnerOrAdmin();
      allow list: if isVerified() && isDocOwnerOrAdmin();

      allow create: if isValidId(loanId)
        && isVerified()
        && isValidLoan(incoming())
        && incoming().id == loanId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/assets/$(incoming().assetId));

      allow update: if isValidId(loanId)
        && isVerified()
        && isValidLoan(incoming())
        && isOwnerOrAdmin()
        && existing().status != 'Returned'
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (incoming().status == 'Returned' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'dateReturned', 'returnedNotes', 'updatedAt']))
          ||
          (incoming().status == 'Overdue' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isValidId(loanId)
        && isVerified()
        && isOwnerOrAdmin();
    }

    // Maintenance Collection
    match /maintenance/{taskId} {
      allow get: if isValidId(taskId) && isVerified() && isOwnerOrAdmin();
      allow list: if isVerified() && isDocOwnerOrAdmin();

      allow create: if isValidId(taskId)
        && isVerified()
        && isValidMaintenance(incoming())
        && incoming().id == taskId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(taskId)
        && isVerified()
        && isValidMaintenance(incoming())
        && isOwnerOrAdmin()
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['column', 'priority', 'diagnosis', 'costEstimate', 'completedDate', 'assignedTechnician', 'description', 'updatedAt']);

      allow delete: if isValidId(taskId)
        && isVerified()
        && isOwnerOrAdmin();
    }

    // System Meta Collection (tracks catalog initialization & Reset-to-0 state)
    match /system_meta/{metaId} {
      allow get: if isValidId(metaId) && isVerified() && isOwnerOrAdmin();
      allow list: if isVerified() && isDocOwnerOrAdmin();

      allow create: if isValidId(metaId)
        && metaId == 'catalog'
        && isVerified()
        && isValidSystemMeta(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(metaId)
        && metaId == 'catalog'
        && isVerified()
        && isValidSystemMeta(incoming())
        && isOwnerOrAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['initialized', 'mode', 'updatedAt']);

      allow delete: if isValidId(metaId)
        && isVerified()
        && isOwnerOrAdmin();
    }
  }
}
